@inject AdminApiState ApiState
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="/">
            <span class="me-2">🏨</span> Admin Console
        </a>
    </div>
</div>

<input type="checkbox" title="Меню навигации" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Главная
            </NavLink>
        </div>

        @if (!ApiState.IsAuthenticated)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="login">
                    <span class="bi bi-key-fill-nav-menu" aria-hidden="true"></span> Вход
                </NavLink>
            </div>
        }

        @if (ApiState.IsAuthenticated)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="dashboard">
                    <span class="bi bi-speedometer-nav-menu" aria-hidden="true"></span> Сводка
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="hotels">
                    <span class="bi bi-building-nav-menu" aria-hidden="true"></span> Отели
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="rooms">
                    <span class="bi bi-door-open-fill-nav-menu" aria-hidden="true"></span> Номера
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="settings">
                    <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span> Настройки
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        // Подписываемся на изменения состояния авторизации
        // В Blazor Server Scoped сервисы сохраняются в рамках circuit между навигациями
        ApiState.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }

    public void Dispose()
    {
        ApiState.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private void OnAuthenticationStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }
}
