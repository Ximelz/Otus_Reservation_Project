@page "/rooms"
@implements IDisposable
@inject AdminApiClient ApiClient
@inject AdminApiState ApiState

<PageTitle>Управление номерами</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">🚪 Управление номерами</h2>
</div>

@if (!ApiState.IsAuthenticated)
{
    <div class="alert alert-warning">
        <strong>⚠️ Требуется авторизация</strong><br />
        Сначала выполните <NavLink href="/login" class="alert-link">вход в систему</NavLink>.
    </div>
}
else
{
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">🔍 Загрузка номеров</h5>
        </div>
        <div class="card-body">
            <EditForm Model="_loadModel" OnValidSubmit="LoadRooms" FormName="roomsLoad">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">ID отеля <span class="text-danger">*</span></label>
                        <InputNumber class="form-control" @bind-Value="_loadModel.HotelId" placeholder="Введите ID отеля" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button class="btn btn-primary w-100" type="submit" disabled="@_isLoading">
                            @if (_isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            }
                            Загрузить номера
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">➕ Добавить / Редактировать номер</h5>
        </div>
        <div class="card-body">
            <EditForm Model="_room" OnValidSubmit="SaveRoom" FormName="roomForm">
                <div class="row g-3">
                    <div class="col-md-2">
                        <label class="form-label fw-semibold">ID <small class="text-muted">(0 для нового)</small></label>
                        <InputNumber class="form-control" @bind-Value="_room.Id" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">ID отеля <span class="text-danger">*</span></label>
                        <InputNumber class="form-control" @bind-Value="_room.HotelId" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Номер комнаты <span class="text-danger">*</span></label>
                        <InputText class="form-control" @bind-Value="_room.Number" placeholder="101" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Вместимость</label>
                        <InputNumber class="form-control" @bind-Value="_room.Capacity" min="1" max="10" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Уровень комфорта</label>
                        <InputNumber class="form-control" @bind-Value="_room.ComfortLevel" min="1" max="5" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Цена за ночь</label>
                        <div class="input-group">
                            <InputNumber class="form-control" @bind-Value="_room.Price" min="0" step="0.01" />
                            <span class="input-group-text">₽</span>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <button class="btn btn-success" type="submit" disabled="@_isSaving">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            }
                            Сохранить номер
                        </button>
                        <button class="btn btn-outline-secondary ms-2" type="button" @onclick="ClearForm">Очистить</button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
            @_message
            <button type="button" class="btn-close" @onclick="() => _message = null"></button>
        </div>
    }

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">📋 Список номеров (@_rooms.Count)</h5>
        </div>
        <div class="card-body">
            @if (_rooms.Count == 0)
            {
                <p class="text-muted text-center mb-0">Номера не найдены. Укажите ID отеля и нажмите "Загрузить номера".</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>ID отеля</th>
                                <th>Номер</th>
                                <th>Вместимость</th>
                                <th>Комфорт</th>
                                <th>Цена</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var room in _rooms)
                            {
                                <tr>
                                    <td><code>@room.Id</code></td>
                                    <td>@room.HotelId</td>
                                    <td><strong>@room.Number</strong></td>
                                    <td>@room.Capacity</td>
                                    <td>@room.ComfortLevel</td>
                                    <td><strong>@room.Price.ToString("N2") ₽</strong></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => EditRoom(room)" title="Редактировать">
                                            ✏️ Изменить
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => DeleteRoom(room.Id)" title="Удалить">
                                            🗑️ Удалить
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    private RoomLoadModel _loadModel = new();
    private readonly List<RoomDto> _rooms = new();
    private RoomDto _room = new();
    private string? _message;
    private bool _isError;
    private bool _isLoading;
    private bool _isSaving;

    private class RoomLoadModel
    {
        public long? HotelId { get; set; }
    }

    private async Task LoadRooms()
    {
        _message = null;
        _isError = false;
        _rooms.Clear();
        _isLoading = true;

        try
        {
            if (!_loadModel.HotelId.HasValue)
            {
                _message = "Укажите ID отеля для загрузки номеров.";
                _isError = true;
                return;
            }

            var result = await ApiClient.GetRoomsByHotel(_loadModel.HotelId.Value, CancellationToken.None);
            if (!result.Success)
            {
                _message = result.Error ?? "Ошибка при загрузке номеров.";
                _isError = true;
                return;
            }

            _rooms.AddRange(result.Data ?? []);
            if (_rooms.Count == 0)
            {
                _message = "Номера не найдены для указанного отеля.";
                _isError = false;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveRoom()
    {
        _message = null;
        _isError = false;
        _isSaving = true;

        try
        {
            var result = await ApiClient.UpsertRoom(_room, CancellationToken.None);
            if (!result.Success)
            {
                _message = result.Error ?? "Ошибка при сохранении номера.";
                _isError = true;
                return;
            }

            _message = _room.Id == 0 ? "Номер успешно создан." : "Номер успешно обновлен.";
            _isError = false;
            ClearForm();
            if (_loadModel.HotelId.HasValue)
            {
                await LoadRooms();
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void EditRoom(RoomDto room)
    {
        _room = room with { };
        _loadModel.HotelId = room.HotelId;
    }

    private void ClearForm()
    {
        _room = new RoomDto();
    }

    private async Task DeleteRoom(long id)
    {
        _message = null;
        _isError = false;

        var result = await ApiClient.DeleteRoom(id, CancellationToken.None);
        if (!result.Success)
        {
            _message = result.Error ?? "Ошибка при удалении номера.";
            _isError = true;
            return;
        }

        _message = "Номер успешно удален.";
        _isError = false;
        _rooms.RemoveAll(r => r.Id == id);
    }

    protected override void OnInitialized()
    {
        // Подписываемся на изменения состояния авторизации
        ApiState.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }

    public void Dispose()
    {
        ApiState.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private void OnAuthenticationStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }
}

